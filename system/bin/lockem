#!/system/bin/sh
# lockem CLI. On PATH for any root shell. `unlock` is self-contained (no daemon needed)
# so it works for recovery from adb-su / recovery / GSI. Other subcommands signal the daemon.

LDIR=/data/adb/lockem
PKG="$LDIR/packages.list"
CTL="$LDIR/ctl"
CFG="$LDIR/config"
DAEMON=/data/adb/modules/lockem/bin/lockemd

cfg() { grep -E "^$1=" "$CFG" 2>/dev/null | head -n1 | cut -d= -f2-; }

do_unlock() {
  if [ ! -f "$PKG" ]; then echo "lockem: no packages.list"; return 1; fi
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    case "$p" in \#*) continue ;; esac
    # reject anything but [A-Za-z0-9._] (junk / shell-injection guard)
    case "$p" in *[!A-Za-z0-9._]*) echo "lockem: skip invalid pkg: $p"; continue ;; esac
    # </dev/null is load-bearing: pm/cmd run app_process, which otherwise swallows this
    # loop's stdin (packages.list) and the unhide/enable silently no-op. We CAPTURE the
    # output (command substitution → a shell pipe) and let the shell append it to the log,
    # rather than handing pm/cmd a direct fd to lockem.log: passing the daemon's own log
    # fd into the package service fails ("Failed transaction"). This mirrors the daemon's
    # run_logged (popen + the daemon writes the log).
    out=$(pm unhide "$p" </dev/null 2>&1; pm enable "$p" </dev/null 2>&1; \
          pm enable --user 0 "$p" </dev/null 2>&1)
    { echo "[cli unlock] $p"; [ -n "$out" ] && echo "$out"; } >> "$LDIR/lockem.log"
    echo "unlocked: $p"
  done < "$PKG"
  if [ -f "$LDIR/state" ]; then
    # parse (don't source) — state is data, not code
    devopts_prev=$(grep -E '^devopts_prev=' "$LDIR/state" 2>/dev/null | head -n1 | cut -d= -f2-)
    if [ -n "$devopts_prev" ]; then
      if [ "$devopts_prev" = "null" ]; then
        out=$(settings delete global development_settings_enabled </dev/null 2>&1)
      else
        out=$(settings put global development_settings_enabled "$devopts_prev" </dev/null 2>&1)
      fi
      { echo "[cli unlock] devopts restore"; [ -n "$out" ] && echo "$out"; } >> "$LDIR/lockem.log"
    fi
  fi
  echo "lockem: unlock complete"
}

signal() { mkdir -p "$CTL"; : > "$CTL/$1"; echo "lockem: signaled $1"; }

case "$1" in
  unlock)              do_unlock ;;
  lock)                signal lock_now ;;
  reload)              signal reload ;;
  record-lock-combo)   signal record_lock ;;
  record-unlock-combo) signal record_unlock ;;
  status)
    if pgrep -f "$DAEMON" >/dev/null 2>&1; then echo "daemon: running"; else echo "daemon: NOT running"; fi
    echo "packages:"; cat "$PKG" 2>/dev/null
    ;;
  log)
    n="${2:-200}"
    case "$n" in *[!0-9]*) n=200 ;; esac
    if [ -f "$LDIR/lockem.log" ]; then
      tail -n "$n" "$LDIR/lockem.log" 2>/dev/null || cat "$LDIR/lockem.log"
    else
      echo "lockem: no log at $LDIR/lockem.log"
    fi
    ;;
  *)
    echo "usage: lockem {lock|unlock|reload|status|log [N]|record-lock-combo|record-unlock-combo}"
    exit 1 ;;
esac
